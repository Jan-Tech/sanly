# Gateway (all API calls routed through here)
EXPO_PUBLIC_GATEWAY_URL=http://192.168.1.100:8080

# Service tokens — same as portal VITE_*_TOKEN values
# Required for services that have officer-based auth (citizen JWT is not accepted)
EXPO_PUBLIC_MEDICAL_TOKEN=
EXPO_PUBLIC_DMV_TOKEN=
EXPO_PUBLIC_TAX_TOKEN=
EXPO_PUBLIC_BUSINESS_TOKEN=
EXPO_PUBLIC_CIVIL_TOKEN=
EXPO_PUBLIC_EDUCATION_TOKEN=
EXPO_PUBLIC_LAND_TOKEN=
EXPO_PUBLIC_SOCIAL_TOKEN=
EXPO_PUBLIC_PENSION_TOKEN=
EXPO_PUBLIC_VEHICLE_TOKEN=
EXPO_PUBLIC_CUSTOMS_TOKEN=
EXPO_PUBLIC_COURT_TOKEN=
EXPO_PUBLIC_SIGNATURE_TOKEN=

# Bridge — access log queries (institution key for INST_PORTAL)
EXPO_PUBLIC_BRIDGE_INSTITUTION_CODE=INST_PORTAL
EXPO_PUBLIC_BRIDGE_INSTITUTION_KEY=
