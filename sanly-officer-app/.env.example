# SANLY Officer App — Environment Variables
# Copy to .env and fill in values

# Gateway URL (all service calls route through here)
EXPO_PUBLIC_GATEWAY_URL=http://localhost:8080

# Service tokens for downstream service API calls
# Each token is a Bearer token for a ROLE_INSTITUTION account in that service
EXPO_PUBLIC_POLICE_TOKEN=your-police-service-token
EXPO_PUBLIC_DMV_TOKEN=your-dmv-service-token
EXPO_PUBLIC_MEDICAL_TOKEN=your-medical-service-token
EXPO_PUBLIC_CUSTOMS_TOKEN=your-customs-service-token
EXPO_PUBLIC_CIVIL_TOKEN=your-civil-service-token
EXPO_PUBLIC_COURT_TOKEN=your-court-service-token
EXPO_PUBLIC_EDUCATION_TOKEN=your-education-service-token
EXPO_PUBLIC_LAND_TOKEN=your-land-service-token
EXPO_PUBLIC_TAX_TOKEN=your-tax-service-token
EXPO_PUBLIC_SOCIAL_TOKEN=your-social-service-token
EXPO_PUBLIC_APPOINTMENTS_TOKEN=your-appointments-service-token
EXPO_PUBLIC_DMV_VERIFY_TOKEN=your-dmv-verify-token

# Bridge credentials (for cross-service data lookups via SANLY Bridge)
EXPO_PUBLIC_BRIDGE_INSTITUTION_CODE=INST_OFFICER_APP
EXPO_PUBLIC_BRIDGE_INSTITUTION_KEY=your-bridge-institution-key
