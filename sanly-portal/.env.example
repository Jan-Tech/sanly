# API Gateway URL (single entry point for all services)
# In Docker: http://sanly-gateway:8080 (set via docker-compose)
# Local dev: http://localhost:8080
VITE_GATEWAY_URL=http://localhost:8080

# Service account JWTs for downstream services
# Each service needs an officer/admin account whose JWT is stored here.
# In production, use a Backend-for-Frontend (BFF) to keep these server-side.
# To obtain: log into each service as admin, get JWT from POST /api/v1/auth/login

VITE_MEDICAL_TOKEN=eyJhbGciOiJIUzI1NiJ9...
VITE_DMV_TOKEN=eyJhbGciOiJIUzI1NiJ9...
VITE_TAX_TOKEN=eyJhbGciOiJIUzI1NiJ9...
VITE_BUSINESS_TOKEN=eyJhbGciOiJIUzI1NiJ9...
VITE_CIVIL_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Education admin JWT — for reading citizen diplomas/enrollments.
# Obtain: POST http://localhost:8080/education/api/v1/education/auth/login with admin credentials.
VITE_EDUCATION_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Land registry admin JWT — for reading citizen properties/transfers.
# Obtain: POST http://localhost:8080/land/api/v1/land/auth/login with admin credentials.
VITE_LAND_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Social benefits admin JWT — for reading citizen claims, pensions, unemployment records.
# Obtain: POST http://localhost:8080/social/api/v1/social/auth/login with admin credentials.
VITE_SOCIAL_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Customs admin JWT — for reading citizen/business declarations.
# Obtain: POST http://localhost:8080/customs/api/v1/customs/auth/login with admin credentials.
VITE_CUSTOMS_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Court admin JWT — for reading citizen cases, fines, and documents.
# Obtain: POST http://localhost:8080/court/api/v1/court/auth/login with admin credentials.
VITE_COURT_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Vehicle registry admin JWT — for reading citizen vehicle records.
# Obtain: POST http://localhost:8080/vehicle/api/v1/vehicle/auth/login with admin credentials.
VITE_VEHICLE_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Pension admin JWT — for reading citizen pension accounts and contributions.
# Obtain: POST http://localhost:8080/pension/api/v1/pension/auth/login with admin credentials.
VITE_PENSION_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Bridge institution credentials for access log queries
VITE_BRIDGE_INSTITUTION_CODE=INST_PORTAL
VITE_BRIDGE_INSTITUTION_KEY=your_institution_key_from_bridge
