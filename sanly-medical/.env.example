# ============================================================
# SANLY Medical Service — Environment Variables Template
# Copy to .env and fill in real values before running.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
DB_USERNAME=medical_user
DB_PASSWORD=change_me_strong_password

# --- JWT (must be ≥ 32 chars) ---
JWT_SECRET=change_me_medical_jwt_secret_at_least_32_chars!!

# --- Field-level Encryption for notes (exactly 32 chars, AES-256) ---
ENCRYPTION_KEY=change_me_exactly_32_chars_long!!

# --- Initial admin password ---
ADMIN_PASSWORD=Admin@Medical2024!

# --- SANLY Citizen Registry (get institution JWT from citizen-registry admin) ---
CITIZEN_REGISTRY_URL=http://localhost:8080
CITIZEN_REGISTRY_TOKEN=<JWT_from_citizen_registry_ROLE_INSTITUTION_account>

# --- SANLY Bridge (get API key from bridge admin after registering INST_MEDICAL) ---
BRIDGE_URL=http://localhost:8081
BRIDGE_INSTITUTION_KEY=sk_bridge_<64-hex-chars>

# --- pgAdmin ---
PGADMIN_EMAIL=admin@sanly.tm
PGADMIN_PASSWORD=pgadmin_dev

# --- Server ---
SERVER_PORT=8082
