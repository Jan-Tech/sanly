# ============================================================
# SANLY Bridge — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
DB_USERNAME=bridge_user
DB_PASSWORD=change_me_strong_password

# --- JWT (for admin endpoints, must be ≥ 32 chars) ---
JWT_SECRET=change_me_bridge_jwt_secret_at_least_32_chars!!

# --- Initial Admin User ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@Bridge2024!

# --- pgAdmin ---
PGADMIN_EMAIL=admin@sanly.tm
PGADMIN_PASSWORD=pgadmin_dev

# --- Server ---
SERVER_PORT=8081
