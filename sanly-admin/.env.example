# SANLY Admin Dashboard — Environment Configuration
# Copy to .env and fill in values.

# API Gateway URL (single entry point for all services)
# In Docker: http://sanly-gateway:8080 (set via docker-compose)
# Local dev: http://localhost:8080
VITE_GATEWAY_URL=http://localhost:8080

# Admin JWT for SANLY Bridge (separate from citizen-registry JWT).
# Obtain: POST /bridge/api/v1/auth/login via gateway with bridge admin credentials.
VITE_BRIDGE_ADMIN_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Admin/officer JWTs for institution services (for citizen detail page data).
# Obtain: POST /{service}/api/v1/auth/login via gateway with admin credentials.
VITE_MEDICAL_TOKEN=eyJhbGciOiJIUzI1NiJ9...
VITE_DMV_TOKEN=eyJhbGciOiJIUzI1NiJ9...
VITE_POLICE_TOKEN=eyJhbGciOiJIUzI1NiJ9...
VITE_TAX_TOKEN=eyJhbGciOiJIUzI1NiJ9...
VITE_BUSINESS_TOKEN=eyJhbGciOiJIUzI1NiJ9...
VITE_CIVIL_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Education admin JWT — for managing institutions, diplomas, enrollment queue.
# Obtain: POST /education/api/v1/education/auth/login via gateway with admin credentials.
VITE_EDUCATION_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Land registry admin JWT — for managing property lookups and transfer approvals.
# Obtain: POST /land/api/v1/land/auth/login via gateway with admin credentials.
VITE_LAND_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Social benefits admin JWT — for managing programs, claims queue, and payments.
# Obtain: POST /social/api/v1/social/auth/login via gateway with admin credentials.
VITE_SOCIAL_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Customs admin JWT — for managing declarations, duties, and port operations.
# Obtain: POST /customs/api/v1/customs/auth/login via gateway with admin credentials.
VITE_CUSTOMS_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Court admin JWT — for managing cases, verdicts, and fine queue.
# Obtain: POST /court/api/v1/court/auth/login via gateway with admin credentials.
VITE_COURT_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Vehicle registry admin JWT — for managing vehicles, transfers, and inspection alerts.
# Obtain: POST /vehicle/api/v1/vehicle/auth/login via gateway with admin credentials.
VITE_VEHICLE_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Pension admin JWT — for managing retirement applications and payment schedule.
# Obtain: POST /pension/api/v1/pension/auth/login via gateway with admin credentials.
VITE_PENSION_TOKEN=eyJhbGciOiJIUzI1NiJ9...
