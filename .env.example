# ============================================================
# SANLY Citizen Registry — Environment Variables Template
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
DB_USERNAME=sanly_user
DB_PASSWORD=change_me_strong_password

# --- JWT (must be ≥ 32 characters, use a random 64-char string in prod) ---
JWT_SECRET=change_me_at_least_32_chars_long_jwt_secret_key_here!!

# --- Field-level Encryption (must be exactly 32 characters for AES-256) ---
ENCRYPTION_KEY=change_me_exactly_32_chars_long!!

# --- Initial Admin User (seeded at startup) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@Sanly2024!

# --- Initial Institution User (seeded at startup) ---
INSTITUTION_USERNAME=institution
INSTITUTION_PASSWORD=Inst@Sanly2024!

# --- pgAdmin (optional, only used with docker-compose) ---
PGADMIN_EMAIL=admin@sanly.tm
PGADMIN_PASSWORD=pgadmin_dev

# --- Server ---
SERVER_PORT=8080
