# ============================================================
# SANLY DMV Service — Environment Variables Template
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

DB_USERNAME=dmv_user
DB_PASSWORD=change_me_strong_password

# JWT secret (≥ 32 chars)
JWT_SECRET=change_me_dmv_jwt_secret_at_least_32_chars!!!

# Initial admin password
ADMIN_PASSWORD=Admin@Dmv2024!

# SANLY Citizen Registry — JWT from a ROLE_INSTITUTION account
CITIZEN_REGISTRY_URL=http://localhost:8080
CITIZEN_REGISTRY_TOKEN=<JWT_from_citizen_registry_ROLE_INSTITUTION_account>

# SANLY Bridge — API key obtained after registering INST_DMV
BRIDGE_URL=http://localhost:8081
BRIDGE_INSTITUTION_KEY=sk_bridge_<64-hex-chars>

PGADMIN_EMAIL=admin@sanly.tm
PGADMIN_PASSWORD=pgadmin_dev
SERVER_PORT=8083
